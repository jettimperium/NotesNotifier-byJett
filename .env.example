# Токен бота из Discord Developer Portal -> Bot -> Reset Token.
# Вставляйте токен в файл .env, а не сюда.
# Никому не показывайте токен и не выкладывайте его в интернет.
DISCORD_TOKEN=

# Необязательные настройки (можно оставить закомментированными):
# DEFAULT_TIMEZONE=Europe/Moscow
# DEFAULT_REMIND_MINUTES=20
# MAX_EVENTS=25
# DB_PATH=data/notes.db
# LOG_PATH=data/bot.log
